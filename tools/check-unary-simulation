"""Check that the unary simulation tests execute their value assertions."""

import os
from pathlib import Path
import subprocess
import sys
import tempfile

repo = Path(__file__).resolve().parent.parent

with tempfile.TemporaryDirectory() as tmp:
    env = dict(
        os.environ,
        OUT_DIR=tmp,
        CONF_DIR=str(repo / 'conf'),
        TESTS_DIR=str(repo / 'tests'),
        RUNNERS_DIR=str(repo / 'tools/runners'),
        THIRD_PARTY_DIR=str(repo / 'third_party'))

    for operator, value in (('inc', 13), ('dec', 11)):
        source = repo / f'tests/chapter-11/11.4.2--unary_op_{operator}-sim.sv'
        for false_oracle in (False, True):
            sample = Path(tmp) / 'sample.sv'
            text = source.read_text()
            if false_oracle:
                text = text.replace(f'({value} == %d)', f'({value + 1} == %d)')
            sample.write_text(text)
            log = Path(tmp) / 'result.log'
            result = subprocess.run(
                [
                    sys.executable,
                    str(repo / 'tools/runner'), '-r', 'Icarus', '-t',
                    str(sample), '-o',
                    str(log)
                ],
                env=env,
                capture_output=True,
                text=True,
                check=True)
            output = log.read_text()
            assert '\nmode: simulation\n' in output, source
            assert '\nrc: 0\n' in output, output
            assert '\n:assert:' in output, output
            expected = 'FAIL:' if false_oracle else 'PASS:'
            assert expected in result.stderr, result.stderr
            print(f'{source.name}: {expected} false_oracle={false_oracle}')
